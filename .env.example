# ───────────── İstemci (tarayıcıya gömülür, gizli değildir) ─────────────
# Firebase Console → Proje ayarları → Genel → Uygulamalarınız → Web uygulaması → SDK yapılandırması
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ───────────── Sunucu (yalnızca /api fonksiyonları — ASLA VITE_ öneki verme) ─────────────
# Firebase Console → Proje ayarları → Hizmet hesapları → Yeni özel anahtar oluştur → indirilen JSON.
# Tek satır JSON veya base64 olarak yapıştır.
FIREBASE_SERVICE_ACCOUNT=
# Sınav oturumlarını imzalamak için rastgele, en az 32 karakterlik gizli anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EXAM_TOKEN_SECRET=
